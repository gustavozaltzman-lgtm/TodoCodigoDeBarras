DATABASE_URL=""

# URL publica del sitio (dominio real en produccion). Sin esto cae al
# fallback de VERCEL_URL, que no es el dominio final.
NEXT_PUBLIC_SITE_URL=""

# WhatsApp de contacto (numero completo con codigo de pais, sin +, sin espacios, ej: 5491112345678)
NEXT_PUBLIC_WHATSAPP_NUMBER=""

# Vercel Blob (se completa al crear el store en el proyecto de Vercel)
BLOB_STORE_ID=""
BLOB_READ_WRITE_TOKEN=""

# Secret para firmar la sesion del admin (generar uno random de 32+ caracteres)
AUTH_SECRET=""

# Notificaciones de leads por email (Resend)
RESEND_API_KEY=""
LEADS_NOTIFICATION_EMAIL=""

# Solo para "npm run db:seed" (crear/actualizar el usuario admin), no se
# usan en runtime de la app
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""
